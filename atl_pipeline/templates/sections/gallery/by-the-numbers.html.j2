{# Gallery alternative: by-the-numbers stats. Asymmetric grid where the
   first stat is double-width with display-sized numeral, the rest are
   regular size. Pushes typography to the limit — numerals at 180px+ —
   to compensate for the absence of imagery. #}
{% set _stats = copy.stats or [] %}
{% set _hero_stat = _stats[0] if _stats else None %}
{% set _rest = _stats[1:] if _stats|length > 1 else [] %}

<section id="gallery" class="gallery-stats" style="padding:{{ tokens.spacing.section_y_lg|default(tokens.spacing.section_y) }} 0;background:{{ tokens.palette.bg }};color:{{ tokens.palette.ink }};border-top:1px solid {{ tokens.palette.border }};border-bottom:1px solid {{ tokens.palette.border }};position:relative;overflow:hidden">
  <div class="wrap">
    <div class="eyebrow" data-motion="kerning-tighten" style="display:inline-flex;align-items:center;gap:14px;color:{{ tokens.palette.accent }};font-size:11px;font-weight:700;letter-spacing:.4em;text-transform:uppercase;margin-bottom:48px">
      <span style="display:inline-block;width:36px;height:1px;background:{{ tokens.palette.accent }}"></span>
      By the numbers
    </div>

    {% if _hero_stat %}
    <div data-motion="reveal-up" style="display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:60px 80px;align-items:start;margin-bottom:80px;padding-bottom:60px;border-bottom:1px solid {{ tokens.palette.border }}">
      <div>
        <div style="font-family:{{ tokens.type.display_family }};font-size:clamp(96px,18vw,260px);font-weight:{{ tokens.type.display_weight }};line-height:.82;color:{{ tokens.palette.accent }};letter-spacing:-0.04em;margin-bottom:18px">{{ _hero_stat.value }}</div>
        <div style="font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.18em;color:{{ tokens.palette.ink }}">{{ _hero_stat.label }}</div>
        {% if _hero_stat.detail %}<div style="font-size:16px;color:{{ tokens.palette.muted }};margin-top:8px;line-height:1.5">{{ _hero_stat.detail }}</div>{% endif %}
      </div>
      {% if _rest|length > 0 %}
      <div style="display:flex;flex-direction:column;gap:36px;padding-top:24px">
        {% for stat in _rest[:2] %}
        <div style="display:grid;grid-template-columns:auto 1fr;gap:24px;align-items:baseline">
          <div style="font-family:{{ tokens.type.display_family }};font-size:clamp(56px,7vw,100px);font-weight:{{ tokens.type.display_weight }};line-height:.85;color:{{ tokens.palette.ink }};letter-spacing:-0.02em">{{ stat.value }}</div>
          <div>
            <div style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.16em;color:{{ tokens.palette.accent }};margin-bottom:6px">{{ stat.label }}</div>
            {% if stat.detail %}<div style="font-size:14px;color:{{ tokens.palette.muted }};line-height:1.5">{{ stat.detail }}</div>{% endif %}
          </div>
        </div>
        {% endfor %}
      </div>
      {% endif %}
    </div>
    {% endif %}

    {# Additional stats spill into a 3-col grid below the asymmetric hero pair #}
    {% set _spill = _rest[2:] if _rest|length > 2 else [] %}
    {% if _spill %}
    <div data-motion="reveal-up" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:40px 48px">
      {% for stat in _spill %}
      <div>
        <div style="font-family:{{ tokens.type.display_family }};font-size:clamp(44px,5vw,72px);font-weight:{{ tokens.type.display_weight }};line-height:.9;color:{{ tokens.palette.accent }};letter-spacing:-0.02em;margin-bottom:8px">{{ stat.value }}</div>
        <div style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.14em;color:{{ tokens.palette.ink }};margin-bottom:4px">{{ stat.label }}</div>
        {% if stat.detail %}<div style="font-size:13px;color:{{ tokens.palette.muted }};line-height:1.5">{{ stat.detail }}</div>{% endif %}
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</section>

{% raw %}<style>@media(max-width:900px){.gallery-stats div[style*="grid-template-columns:minmax(0,1.3fr) minmax(0,1fr)"]{grid-template-columns:1fr !important;gap:36px !important}}</style>{% endraw %}
