{# Gallery variant: CSS columns masonry — accommodates mixed real-photo aspects. #}
<section id="gallery" style="padding:{{ tokens.spacing.section_y }} 0;background:{{ tokens.palette.bg }};color:{{ tokens.palette.ink }}">
  <div class="wrap">
    <div class="eyebrow" style="color:{{ tokens.palette.accent }};font-size:13px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;margin-bottom:20px">— Real work</div>
    <h2 style="font-family:{{ tokens.type.display_family }};font-size:{{ tokens.spacing.h2_size }};font-weight:{{ tokens.type.display_weight }};line-height:1.05;margin-bottom:60px;max-width:880px">{{ copy.gallery_h|safe }}</h2>
    <div style="column-count:3;column-gap:18px">
      {% for p in images.gallery %}
      <figure style="margin:0 0 18px;break-inside:avoid;border-radius:12px;overflow:hidden;box-shadow:0 20px 40px -25px rgba(0,0,0,.25)">
        <img src="{{ p.url }}" alt="{{ p.caption|default(business.name) }}" style="width:100%;height:auto;display:block">
      </figure>
      {% endfor %}
    </div>
  </div>
</section>
{% raw %}<style>@media(max-width:900px){#gallery div[style*="column-count:3"]{column-count:1 !important}}</style>{% endraw %}
