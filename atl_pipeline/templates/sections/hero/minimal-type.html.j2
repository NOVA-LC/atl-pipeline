{# Hero variant: type-only, no photo. Works when photos are weak or missing. #}
<section class="hero hero-minimal" style="padding:{{ tokens.spacing.hero_y_top }} 0 {{ tokens.spacing.hero_y_bottom }};background:{{ tokens.palette.bg }};color:{{ tokens.palette.ink }};border-bottom:1px solid {{ tokens.palette.border }}">
  <div class="wrap" style="max-width:1080px;text-align:center">
    <div class="eyebrow" style="color:{{ tokens.palette.accent }};font-size:13px;font-weight:600;letter-spacing:.25em;text-transform:uppercase;margin-bottom:36px">{{ copy.eyebrow }}</div>
    <h1 data-motion="split-line-reveal" style="font-family:{{ tokens.type.display_family }};font-size:{{ tokens.spacing.h1_size }};font-weight:{{ tokens.type.display_weight }};letter-spacing:{{ tokens.type.display_letter_spacing }};line-height:1.02;margin-bottom:40px">
      {{ copy.headline_top }}{% if copy.headline_em %}<br><em style="font-style:italic;color:{{ tokens.palette.accent }}">{{ copy.headline_em }}</em>{% endif %}
    </h1>
    <p style="font-size:22px;max-width:680px;margin:0 auto 48px;color:{{ tokens.palette.muted }};font-weight:300">{{ copy.hero_sub }}</p>
    <div style="display:flex;gap:14px;flex-wrap:wrap;justify-content:center">
      <a href="tel:{{ business.phone }}" style="padding:18px 36px;background:{{ tokens.palette.ink }};color:#fff;border-radius:999px;text-decoration:none;font-weight:600;font-size:16px">📞 Call · {{ business.phone_display }}</a>
      <a href="#services" style="padding:18px 36px;background:transparent;color:{{ tokens.palette.ink }};border:1.5px solid {{ tokens.palette.border }};border-radius:999px;text-decoration:none;font-weight:600;font-size:16px">{{ copy.hero_cta_text|default('What we do →') }}</a>
    </div>
  </div>
</section>
