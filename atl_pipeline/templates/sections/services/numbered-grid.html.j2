{# Services variant: 3-column numbered grid, editorial. #}
<section id="services" style="padding:{{ tokens.spacing.section_y }} 0;background:{{ tokens.palette.bg }};color:{{ tokens.palette.ink }}">
  <div class="wrap">
    <div class="eyebrow" style="color:{{ tokens.palette.accent }};font-size:13px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;margin-bottom:24px">— What we do</div>
    <h2 style="font-family:{{ tokens.type.display_family }};font-size:{{ tokens.spacing.h2_size }};font-weight:{{ tokens.type.display_weight }};line-height:1.05;margin-bottom:24px;max-width:880px">{{ copy.services_h|safe }}</h2>
    <p style="font-size:19px;max-width:680px;color:{{ tokens.palette.muted }};margin-bottom:60px;font-weight:300">{{ copy.services_lead }}</p>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:{{ tokens.palette.border }}">
      {% for svc in copy.services %}
      <div style="background:{{ tokens.palette.bg }};padding:48px 36px">
        <div style="font-family:{{ tokens.type.display_family }};font-weight:500;font-size:14px;color:{{ tokens.palette.accent }};margin-bottom:20px">— {{ '%02d'|format(loop.index) }}</div>
        <h3 style="font-family:{{ tokens.type.display_family }};font-size:24px;margin-bottom:12px">{{ svc.title }}</h3>
        <p style="color:{{ tokens.palette.muted }};font-size:15px;line-height:1.7">{{ svc.body }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% raw %}<style>@media(max-width:900px){#services > .wrap > div[style*="grid-template-columns"]{grid-template-columns:1fr !important}}</style>{% endraw %}
