{#- Inline SVG icon library. Replaces emoji icons that scream "template" on
   $5K+ tier sites. All icons use currentColor + stroke for theming via CSS.

   Usage: {% include 'partials/icon-svg.html.j2' with context %}{% set icon='snowflake' %}…
   Or:    {% from 'partials/icon-svg.html.j2' import svg_icon %}
          {{ svg_icon('snowflake', size=22) }}

   Available keys: snowflake, flame, wrench, calendar, thermostat, hvac-unit,
   gear, drop, lightning, leaf, hammer, paint-roller, truck, plug, gauge,
   bolt, droplet, shield, clock, phone, mail, map-pin, star, check.

   Falls back to "gear" if key is unknown so render never breaks.
-#}
{%- macro svg_icon(name, size=22, stroke=1.75) -%}
{%- set s = size -%}
{%- set sw = stroke -%}
<svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ sw }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
{%- if name == 'snowflake' -%}
<path d="M12 2v20"/><path d="M4 7l16 10"/><path d="M4 17L20 7"/><path d="M9 4l3-2 3 2"/><path d="M9 20l3 2 3-2"/><path d="M3 9l-1 3 1 3"/><path d="M21 9l1 3-1 3"/>
{%- elif name == 'flame' -%}
<path d="M12 2c0 4-5 6-5 11a5 5 0 0010 0c0-3-2-4-2-6 0 1.5-1.5 2-3-5z"/><path d="M12 13c0 1.5-1.5 2.5-1.5 4a1.5 1.5 0 003 0c0-1.5-1.5-2.5-1.5-4z"/>
{%- elif name == 'wrench' -%}
<path d="M14.7 6.3a4 4 0 00-5.4 5.4l-7 7 1.6 1.6 7-7a4 4 0 005.4-5.4l-2.4 2.4-1.6-1.6 2.4-2.4z"/>
{%- elif name == 'calendar' -%}
<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/><circle cx="8.5" cy="14.5" r=".5" fill="currentColor" stroke="none"/><circle cx="12" cy="14.5" r=".5" fill="currentColor" stroke="none"/><circle cx="15.5" cy="14.5" r=".5" fill="currentColor" stroke="none"/><circle cx="8.5" cy="17.5" r=".5" fill="currentColor" stroke="none"/><circle cx="12" cy="17.5" r=".5" fill="currentColor" stroke="none"/>
{%- elif name == 'thermostat' -%}
<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3.5"/><path d="M12 3v2.5M12 18.5V21M3 12h2.5M18.5 12H21M5.6 5.6l1.8 1.8M16.6 16.6l1.8 1.8M5.6 18.4l1.8-1.8M16.6 7.4l1.8-1.8"/>
{%- elif name == 'hvac-unit' -%}
<rect x="3" y="5" width="18" height="14" rx="1.5"/><path d="M3 10h18M3 15h18"/><path d="M7.5 5V3M16.5 5V3M7.5 21v-2M16.5 21v-2"/>
{%- elif name == 'gear' -%}
<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 008 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83 0 2 2 0 010-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H2a2 2 0 010-4h.09A1.65 1.65 0 004.6 8a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 010-2.83 2 2 0 012.83 0l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V2a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 0 2 2 0 010 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H22a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/>
{%- elif name == 'drop' or name == 'droplet' -%}
<path d="M12 2s-6 7-6 12a6 6 0 0012 0c0-5-6-12-6-12z"/>
{%- elif name == 'lightning' or name == 'bolt' -%}
<polygon points="13,2 3,14 12,14 11,22 21,10 12,10"/>
{%- elif name == 'leaf' -%}
<path d="M11 20A7 7 0 014 13c0-7 8-11 17-11-1 9-5 18-10 18z"/><path d="M2 22c4-4 6-6 9-8"/>
{%- elif name == 'hammer' -%}
<path d="M15 7l5-5 2 2-5 5z"/><path d="M14 6l4 4-7 7-2-2 1-1-3-3-2 2-2-2 7-7 2 2-1 1 3 3z"/>
{%- elif name == 'paint-roller' or name == 'roller' -%}
<rect x="3" y="3" width="18" height="6" rx="1"/><path d="M21 6h2v6H10v3H8v6h4v-6h-2v-3h11"/>
{%- elif name == 'truck' -%}
<rect x="1" y="6" width="14" height="11" rx="1"/><path d="M15 9h4l3 4v4h-7"/><circle cx="6" cy="18" r="2"/><circle cx="17" cy="18" r="2"/>
{%- elif name == 'plug' -%}
<path d="M9 2v4M15 2v4"/><path d="M5 8h14v3a5 5 0 01-5 5h-4a5 5 0 01-5-5z"/><path d="M12 16v6"/>
{%- elif name == 'gauge' -%}
<path d="M12 14l4-4"/><circle cx="12" cy="14" r="9"/><path d="M3 14a9 9 0 0118 0"/>
{%- elif name == 'shield' -%}
<path d="M12 2l8 4v6c0 5-4 9-8 10-4-1-8-5-8-10V6z"/>
{%- elif name == 'clock' -%}
<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
{%- elif name == 'phone' -%}
<path d="M22 16.92v3a2 2 0 01-2.18 2 19.8 19.8 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.13 1 .37 1.97.72 2.91a2 2 0 01-.45 2.11L8.09 10.09a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.94.35 1.91.59 2.91.72A2 2 0 0122 16.92z"/>
{%- elif name == 'mail' -%}
<rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 6l-10 7L2 6"/>
{%- elif name == 'map-pin' -%}
<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/>
{%- elif name == 'star' -%}
<polygon points="12,2 15,9 22,9.5 17,14.5 18.5,22 12,18 5.5,22 7,14.5 2,9.5 9,9"/>
{%- elif name == 'check' -%}
<polyline points="20 6 9 17 4 12"/>
{%- else -%}{# gear fallback so render never breaks on unknown key #}
<circle cx="12" cy="12" r="3"/><circle cx="12" cy="12" r="9"/>
{%- endif -%}
</svg>
{%- endmacro -%}
{# end macro #}
