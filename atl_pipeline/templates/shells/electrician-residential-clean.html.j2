{# Electrician shell #3: residential-clean. Soft navy + white + warm wood,
   Sohne/Inter, lifestyle hero (recessed lighting in modern kitchen),
   service tiles. Reads premium-residential remodeler-adjacent. #}
{% extends "shells/_base.html.j2" %}

{% block main_content %}
<section class="hero" style="padding:100px 0;background:{{ tokens.palette.bg }};color:{{ tokens.palette.ink }}">
  <div class="wrap">
    <div style="max-width:1000px">
      <div style="font-family:{{ tokens.type.display_family }};font-size:12px;font-weight:600;letter-spacing:.32em;text-transform:uppercase;color:{{ tokens.palette.accent }};margin-bottom:32px">Residential electrical · {{ business.city }}, GA</div>
      <h1 data-motion="split-line-reveal" style="font-family:{{ tokens.type.display_family }};font-size:clamp(48px,7vw,108px);font-weight:{{ tokens.type.display_weight }};line-height:1;letter-spacing:-0.025em;margin:0 0 32px">
        {{ copy.headline_top }}{% if copy.headline_em %} <em style="font-style:italic;color:{{ tokens.palette.accent }};font-weight:{{ tokens.type.display_weight }}">{{ copy.headline_em }}</em>{% endif %}
      </h1>
      <p style="font-size:clamp(18px,1.4vw,21px);line-height:1.55;color:{{ tokens.palette.muted }};max-width:620px;margin:0 0 36px">{{ copy.hero_sub }}</p>
      <div style="display:flex;gap:14px;flex-wrap:wrap">
        <a href="tel:{{ business.phone }}" style="background:{{ tokens.palette.ink }};color:{{ tokens.palette.bg }};padding:18px 32px;border-radius:4px;text-decoration:none;font-weight:600">Schedule a consult</a>
        <a href="#services" style="color:{{ tokens.palette.ink }};padding:18px 8px;text-decoration:none;font-weight:600;border-bottom:2px solid {{ tokens.palette.accent }}">Our work →</a>
      </div>
    </div>
    {% if images.hero %}<figure style="margin:64px 0 0;aspect-ratio:21/9;overflow:hidden"><img src="{{ images.hero }}" alt="{{ business.name }} residential work" style="width:100%;height:100%;object-fit:cover;display:block"></figure>{% endif %}
  </div>
</section>

<section id="services" style="padding:120px 0;background:{{ tokens.palette.card_bg }}">
  <div class="wrap">
    <div style="font-family:{{ tokens.type.display_family }};font-size:12px;font-weight:600;letter-spacing:.3em;text-transform:uppercase;color:{{ tokens.palette.accent }};margin-bottom:20px">Where we shine</div>
    <h2 style="font-family:{{ tokens.type.display_family }};font-size:clamp(36px,5vw,68px);font-weight:{{ tokens.type.display_weight }};line-height:1.02;letter-spacing:-0.02em;margin:0 0 56px;max-width:880px">{{ copy.services_h|safe }}</h2>
    <ol data-motion="reveal-up" style="list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:48px 60px">
      {% for svc in copy.services %}
      <li>
        <div style="font-family:{{ tokens.type.display_family }};font-size:13px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:{{ tokens.palette.accent }};margin-bottom:14px">{{ '0%d'|format(loop.index) }} · {{ svc.title }}</div>
        <p style="font-size:16px;color:{{ tokens.palette.muted }};line-height:1.6;margin:0 0 14px">{{ svc.body }}</p>
        {% if svc.price_signal %}<div style="font-size:14px;color:{{ tokens.palette.ink }};font-weight:600;font-style:italic">{{ svc.price_signal }}</div>{% endif %}
      </li>
      {% endfor %}
    </ol>
  </div>
</section>

{% if copy.reviews_list %}
<section id="reviews" style="padding:120px 0;background:{{ tokens.palette.bg }};text-align:center">
  <div class="wrap" style="max-width:920px">
    {% set hq = copy.reviews_list[0] %}
    <div style="color:{{ tokens.palette.accent }};font-size:18px;letter-spacing:4px;margin-bottom:24px">{{ '★' * (hq.stars|default(5)) }}</div>
    <blockquote data-motion="split-line-reveal" style="margin:0 0 28px;font-family:{{ tokens.type.display_family }};font-size:clamp(24px,2.8vw,40px);font-weight:{{ tokens.type.display_weight }};line-height:1.3;font-style:italic">&ldquo;{{ hq.text }}&rdquo;</blockquote>
    <div style="font-size:13px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:{{ tokens.palette.muted }}">— {{ hq.author }}{% if hq.date %} · {{ hq.date }}{% endif %} · {{ business.rating }}★ × {{ business.reviews }} on Google</div>
  </div>
</section>
{% endif %}

{% if copy.environmental_image %}
<section style="position:relative;min-height:60vh;display:flex;align-items:flex-end;padding:48px 0;background:linear-gradient(180deg,rgba(15,20,30,0) 35%,rgba(15,20,30,.55) 75%,rgba(15,20,30,.88) 100%),url('{{ copy.environmental_image }}') center/cover;color:#fff;overflow:hidden">
  <div class="wrap" style="max-width:1280px;width:100%">
    <div style="font-family:{{ tokens.type.display_family }};font-size:11px;font-weight:600;letter-spacing:.4em;text-transform:uppercase;color:{{ tokens.palette.accent }};margin-bottom:24px">{{ copy.environmental_eyebrow|default(business.city|upper + ' · ON THE ROAD') }}</div>
    <p data-motion="split-line-reveal" style="font-family:{{ tokens.type.display_family }};font-size:clamp(28px,4vw,60px);font-weight:{{ tokens.type.display_weight }};line-height:1.06;letter-spacing:-0.015em;margin:0;max-width:920px">{{ copy.environmental_statement|default("On the road in " + business.city + " before most of us are awake.") }}</p>
  </div>
</section>
{% endif %}

<section id="contact" style="padding:120px 0;background:{{ tokens.palette.ink }};color:{{ tokens.palette.bg }};text-align:center">
  <div class="wrap" style="max-width:680px">
    <h2 style="font-family:{{ tokens.type.display_family }};font-size:clamp(40px,5.6vw,80px);font-weight:{{ tokens.type.display_weight }};line-height:1;letter-spacing:-0.022em;margin:0 0 24px">{{ copy.cta_h|safe }}</h2>
    <p style="font-size:18px;color:rgba(255,255,255,.7);margin:0 0 32px">{{ copy.cta_sub }}</p>
    <a href="tel:{{ business.phone }}" style="background:{{ tokens.palette.accent }};color:{{ tokens.palette.bg }};padding:22px 44px;text-decoration:none;font-weight:600;font-size:17px;border-radius:4px">{{ business.phone_display }}</a>
  </div>
</section>
{% endblock %}
