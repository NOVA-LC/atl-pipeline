{# Plumber shell #2: credentialed-trust. Sober navy + white + single red
   accent, Inter, founder/family portrait hero, "Since 19XX / 50,000+
   drains / 5.0★" stat bar, BBB+licensed+insured badge wall. Reads
   insurance-company-approved. #}
{% extends "shells/_base.html.j2" %}

{% block main_content %}
<section class="hero" style="position:relative;padding:80px 0 100px;background:{{ tokens.palette.bg }};color:{{ tokens.palette.ink }};border-bottom:1px solid {{ tokens.palette.border }}">
  <div class="wrap">
    <div style="display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:80px;align-items:center" class="hero-grid">
      <div>
        <div style="display:inline-block;background:{{ tokens.palette.accent }};color:#fff;padding:5px 12px;font-size:11px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;margin-bottom:28px">{{ business.city|upper }} · LICENSED · INSURED</div>
        <h1 data-motion="split-line-reveal" style="font-family:{{ tokens.type.display_family }};font-size:clamp(44px,6.5vw,96px);font-weight:{{ tokens.type.display_weight }};line-height:1.02;letter-spacing:-0.02em;margin:0 0 32px">
          {{ copy.headline_top }}{% if copy.headline_em %} <span style="color:{{ tokens.palette.accent }}">{{ copy.headline_em }}</span>{% endif %}
        </h1>
        <p style="font-size:19px;line-height:1.55;color:{{ tokens.palette.muted }};max-width:540px;margin:0 0 36px">{{ copy.hero_sub }}</p>
        <div style="display:flex;gap:14px;flex-wrap:wrap;align-items:center;margin-bottom:48px">
          <a href="tel:{{ business.phone }}" style="background:{{ tokens.palette.ink }};color:#fff;padding:18px 34px;border-radius:4px;text-decoration:none;font-weight:700;font-size:16px;display:inline-flex;align-items:center;gap:10px">📞 Call · {{ business.phone_display }}</a>
          <a href="#services" style="color:{{ tokens.palette.ink }};padding:18px 12px;text-decoration:none;font-weight:700;font-size:16px;border-bottom:2px solid {{ tokens.palette.accent }}">See what we fix →</a>
        </div>
        <div style="display:flex;gap:32px;flex-wrap:wrap;padding-top:32px;border-top:1px solid {{ tokens.palette.border }}">
          {% if business.years %}<div><div style="font-family:{{ tokens.type.display_family }};font-size:36px;font-weight:{{ tokens.type.display_weight }};color:{{ tokens.palette.ink }};line-height:1">{{ business.years }}+</div><div style="font-size:12px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:{{ tokens.palette.muted }};margin-top:4px">Years in {{ business.city }}</div></div>{% endif %}
          {% if business.rating %}<div><div style="font-family:{{ tokens.type.display_family }};font-size:36px;font-weight:{{ tokens.type.display_weight }};color:{{ tokens.palette.ink }};line-height:1">{{ business.rating }}★</div><div style="font-size:12px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:{{ tokens.palette.muted }};margin-top:4px">{{ business.reviews }} Google reviews</div></div>{% endif %}
          {% if copy.license_number %}<div><div style="font-family:{{ tokens.type.display_family }};font-size:36px;font-weight:{{ tokens.type.display_weight }};color:{{ tokens.palette.ink }};line-height:1">#{{ copy.license_number }}</div><div style="font-size:12px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:{{ tokens.palette.muted }};margin-top:4px">GA Master Plumber</div></div>{% endif %}
        </div>
      </div>
      {% if images.hero %}
      <figure data-motion="parallax-cover" style="margin:0;aspect-ratio:4/5;overflow:hidden;position:relative">
        <img src="{{ images.hero }}" alt="{{ business.name }} owner-operator" style="width:100%;height:100%;object-fit:cover;display:block">
        {% if copy.owner_first_name %}<figcaption style="position:absolute;bottom:0;left:0;right:0;background:linear-gradient(180deg,transparent,rgba(0,0,0,.7));color:#fff;padding:32px 20px 18px;font-size:13px;font-weight:600;letter-spacing:.12em;text-transform:uppercase">{{ copy.owner_first_name }} · OWNER-OPERATOR{% if business.years %} · {{ business.years }} YRS{% endif %}</figcaption>{% endif %}
      </figure>
      {% endif %}
    </div>
  </div>
</section>
{% raw %}<style>@media(max-width:900px){.hero-grid{grid-template-columns:1fr !important;gap:48px !important}}</style>{% endraw %}

<section style="background:{{ tokens.palette.card_bg }};padding:32px 0;border-bottom:1px solid {{ tokens.palette.border }}">
  <div class="wrap" style="display:flex;gap:32px;align-items:center;justify-content:center;flex-wrap:wrap">
    {% for badge in ['BBB A+ ACCREDITED', 'LICENSED & INSURED', 'FLAT-RATE PRICING', 'OWNER-ON-EVERY-JOB', '100% SATISFACTION'] %}
    <span style="font-family:{{ tokens.type.display_family }};font-size:12px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:{{ tokens.palette.muted }};display:inline-flex;align-items:center;gap:8px">
      <span style="display:inline-block;width:6px;height:6px;background:{{ tokens.palette.accent }};border-radius:50%"></span>{{ badge }}
    </span>
    {% endfor %}
  </div>
</section>

<section id="services" style="padding:120px 0;background:{{ tokens.palette.bg }}">
  <div class="wrap">
    <div style="font-family:{{ tokens.type.display_family }};font-size:12px;font-weight:700;letter-spacing:.3em;text-transform:uppercase;color:{{ tokens.palette.accent }};margin-bottom:24px">— SERVICES</div>
    <h2 style="font-family:{{ tokens.type.display_family }};font-size:clamp(40px,5.4vw,72px);font-weight:{{ tokens.type.display_weight }};line-height:1;letter-spacing:-0.02em;margin:0 0 56px;max-width:880px">{{ copy.services_h|safe }}</h2>
    <div data-motion="reveal-up" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px">
      {% for svc in copy.services %}
      <div style="padding:36px 28px;border:1px solid {{ tokens.palette.border }};background:{{ tokens.palette.card_bg }};display:flex;flex-direction:column;justify-content:space-between;min-height:220px">
        <div>
          <div style="font-family:{{ tokens.type.display_family }};font-size:13px;font-weight:700;color:{{ tokens.palette.accent }};letter-spacing:.16em;text-transform:uppercase;margin-bottom:14px">{{ '%02d / %02d'|format(loop.index, copy.services|length) }}</div>
          <h3 style="font-family:{{ tokens.type.display_family }};font-size:22px;font-weight:{{ tokens.type.display_weight }};line-height:1.15;margin:0 0 10px">{{ svc.title }}</h3>
          <p style="font-size:14px;line-height:1.65;color:{{ tokens.palette.muted }};margin:0">{{ svc.body }}</p>
        </div>
        {% if svc.price_signal %}<div style="margin-top:24px;padding-top:18px;border-top:1px solid {{ tokens.palette.border }};font-family:{{ tokens.type.display_family }};font-size:18px;font-weight:{{ tokens.type.display_weight }};color:{{ tokens.palette.ink }}">{{ svc.price_signal }}</div>{% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>

{% if copy.guarantee %}
<section style="padding:120px 0;background:{{ tokens.palette.ink }};color:#fff;text-align:center">
  <div class="wrap" style="max-width:920px">
    <div style="font-family:{{ tokens.type.display_family }};font-size:12px;font-weight:700;letter-spacing:.3em;text-transform:uppercase;color:{{ tokens.palette.accent }};margin-bottom:24px">— OUR GUARANTEE</div>
    <p data-motion="split-line-reveal" style="font-family:{{ tokens.type.display_family }};font-size:clamp(28px,4vw,52px);font-weight:{{ tokens.type.display_weight }};line-height:1.18;letter-spacing:-0.01em;margin:0">{{ copy.guarantee }}</p>
  </div>
</section>
{% endif %}

{% if copy.reviews_list %}
<section id="reviews" style="padding:120px 0;background:{{ tokens.palette.card_bg }}">
  <div class="wrap">
    <div style="font-family:{{ tokens.type.display_family }};font-size:12px;font-weight:700;letter-spacing:.3em;text-transform:uppercase;color:{{ tokens.palette.accent }};margin-bottom:24px">— {{ business.rating }}★ × {{ business.reviews }} REVIEWS</div>
    <div data-motion="reveal-up" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:24px">
      {% for r in copy.reviews_list[:3] %}
      <div style="background:{{ tokens.palette.bg }};padding:32px;border-top:3px solid {{ tokens.palette.accent }}">
        <div style="color:{{ tokens.palette.accent }};font-size:14px;letter-spacing:3px;margin-bottom:14px">{{ '★' * (r.stars|default(5)) }}</div>
        <p style="font-size:15px;line-height:1.65;margin:0 0 18px;color:{{ tokens.palette.ink }}">&ldquo;{{ r.text }}&rdquo;</p>
        <div style="font-size:12px;color:{{ tokens.palette.muted }};letter-spacing:.12em;text-transform:uppercase;font-weight:700">— {{ r.author }}{% if r.date %} · {{ r.date }}{% endif %}</div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section id="contact" style="padding:120px 0;background:{{ tokens.palette.bg }};text-align:center">
  <div class="wrap" style="max-width:760px">
    <h2 data-motion="split-line-reveal" style="font-family:{{ tokens.type.display_family }};font-size:clamp(40px,5.4vw,80px);font-weight:{{ tokens.type.display_weight }};line-height:1;letter-spacing:-0.022em;margin:0 0 24px">{{ copy.cta_h|safe }}</h2>
    <p style="font-size:18px;color:{{ tokens.palette.muted }};max-width:540px;margin:0 auto 36px">{{ copy.cta_sub }}</p>
    <a href="tel:{{ business.phone }}" style="display:inline-flex;align-items:center;gap:14px;background:{{ tokens.palette.ink }};color:#fff;padding:24px 48px;text-decoration:none;font-weight:700;font-size:18px">📞 {{ business.phone_display }}</a>
  </div>
</section>
{% endblock %}
