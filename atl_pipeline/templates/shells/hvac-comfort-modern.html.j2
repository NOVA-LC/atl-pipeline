{# HVAC shell #2: comfort-modern. Pale sky + warm sand + charcoal, rounded
   geometry, lifestyle photography (parent + kid on couch vibe). Premium home-
   improvement positioning. #}
{% extends "shells/_base.html.j2" %}

{% block main_content %}
<section class="hero" style="position:relative;padding:120px 0;background:{{ tokens.palette.bg }};color:{{ tokens.palette.ink }};overflow:hidden">
  <div class="wrap" style="position:relative">
    <div style="text-align:center;max-width:980px;margin:0 auto">
      <div style="font-family:{{ tokens.type.display_family }};font-size:12px;font-weight:600;letter-spacing:.3em;text-transform:uppercase;color:{{ tokens.palette.accent }};margin-bottom:36px">Comfort, engineered for {{ business.city }} homes</div>
      <h1 data-motion="split-line-reveal" style="font-family:{{ tokens.type.display_family }};font-size:clamp(48px,7vw,108px);font-weight:{{ tokens.type.display_weight }};line-height:1;letter-spacing:-0.025em;margin:0 0 32px">
        {{ copy.headline_top }}{% if copy.headline_em %} <em style="font-style:italic;color:{{ tokens.palette.accent }};font-weight:{{ tokens.type.display_weight }}">{{ copy.headline_em }}</em>{% endif %}
      </h1>
      <p style="font-size:clamp(18px,1.4vw,22px);line-height:1.55;color:{{ tokens.palette.muted }};max-width:680px;margin:0 auto 40px">{{ copy.hero_sub }}</p>
      <div style="display:flex;gap:14px;flex-wrap:wrap;justify-content:center">
        <a href="tel:{{ business.phone }}" style="background:{{ tokens.palette.ink }};color:{{ tokens.palette.bg }};padding:20px 36px;border-radius:999px;text-decoration:none;font-weight:600">Schedule a comfort check</a>
        <a href="#services" style="color:{{ tokens.palette.ink }};padding:20px 18px;text-decoration:none;font-weight:600;border-bottom:2px solid {{ tokens.palette.accent }}">Our services →</a>
      </div>
    </div>
    {% if images.hero %}
    <figure style="margin:60px -32px 0;aspect-ratio:21/9;overflow:hidden;border-radius:24px">
      <img src="{{ images.hero }}" alt="A comfortable home" style="width:100%;height:100%;object-fit:cover;display:block">
    </figure>
    {% endif %}
  </div>
</section>

<section id="services" style="padding:120px 0;background:{{ tokens.palette.card_bg }}">
  <div class="wrap">
    <div style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,2fr);gap:60px;align-items:start" class="svc-grid">
      <div style="position:sticky;top:80px">
        <div style="font-family:{{ tokens.type.display_family }};font-size:12px;font-weight:600;letter-spacing:.3em;text-transform:uppercase;color:{{ tokens.palette.accent }};margin-bottom:16px">Services</div>
        <h2 style="font-family:{{ tokens.type.display_family }};font-size:clamp(36px,4.8vw,64px);font-weight:{{ tokens.type.display_weight }};line-height:1.05;letter-spacing:-0.015em;margin:0;max-width:380px">{{ copy.services_h|safe }}</h2>
      </div>
      <ol style="list-style:none;padding:0;margin:0">
        {% for svc in copy.services %}
        <li style="display:grid;grid-template-columns:60px minmax(0,1fr) auto;gap:24px;padding:28px 0;border-bottom:1px solid {{ tokens.palette.border }};align-items:start" data-motion="reveal-up">
          <div style="font-family:{{ tokens.type.display_family }};font-size:14px;font-weight:600;letter-spacing:.08em;color:{{ tokens.palette.accent }};padding-top:4px">{{ '%02d'|format(loop.index) }}</div>
          <div>
            <h3 style="font-family:{{ tokens.type.display_family }};font-size:22px;font-weight:{{ tokens.type.display_weight }};margin:0 0 8px">{{ svc.title }}</h3>
            <p style="font-size:15px;color:{{ tokens.palette.muted }};line-height:1.65;margin:0">{{ svc.body }}</p>
          </div>
          {% if svc.price_signal %}<div style="font-family:{{ tokens.type.display_family }};font-size:16px;font-weight:600;color:{{ tokens.palette.ink }};white-space:nowrap;padding-top:4px">{{ svc.price_signal }}</div>{% endif %}
        </li>
        {% endfor %}
      </ol>
    </div>
  </div>
</section>
{% raw %}<style>@media(max-width:900px){.svc-grid{grid-template-columns:1fr !important;gap:32px !important}}</style>{% endraw %}

{% if copy.reviews_list %}
<section id="reviews" style="padding:120px 0;background:{{ tokens.palette.bg }};text-align:center">
  <div class="wrap" style="max-width:920px">
    {% set hq = copy.reviews_list[0] %}
    <div style="color:{{ tokens.palette.accent }};font-size:18px;letter-spacing:4px;margin-bottom:24px">{{ '★' * (hq.stars|default(5)) }}</div>
    <blockquote data-motion="split-line-reveal" style="margin:0 0 28px;font-family:{{ tokens.type.display_family }};font-size:clamp(24px,2.8vw,40px);font-weight:{{ tokens.type.display_weight }};line-height:1.3;letter-spacing:-0.01em">&ldquo;{{ hq.text }}&rdquo;</blockquote>
    <div style="font-size:13px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:{{ tokens.palette.muted }}">— {{ hq.author }}{% if hq.date %} · {{ hq.date }}{% endif %} · {{ business.rating }}★ × {{ business.reviews }} on Google</div>
  </div>
</section>
{% endif %}

{% if copy.environmental_image %}
<section style="position:relative;min-height:60vh;display:flex;align-items:flex-end;padding:48px 0;background:linear-gradient(180deg,rgba(15,20,30,0) 35%,rgba(15,20,30,.55) 75%,rgba(15,20,30,.88) 100%),url('{{ copy.environmental_image }}') center/cover;color:#fff;overflow:hidden">
  <div class="wrap" style="max-width:1280px;width:100%">
    <div style="font-family:{{ tokens.type.display_family }};font-size:11px;font-weight:600;letter-spacing:.4em;text-transform:uppercase;color:{{ tokens.palette.accent }};margin-bottom:24px">{{ copy.environmental_eyebrow|default(business.city|upper + ' · ON THE ROAD') }}</div>
    <p data-motion="split-line-reveal" style="font-family:{{ tokens.type.display_family }};font-size:clamp(28px,4vw,60px);font-weight:{{ tokens.type.display_weight }};line-height:1.06;letter-spacing:-0.015em;margin:0;max-width:920px">{{ copy.environmental_statement|default("On the road in " + business.city + " before most of us are awake.") }}</p>
  </div>
</section>
{% endif %}

<section id="contact" style="padding:120px 0;background:{{ tokens.palette.ink }};color:{{ tokens.palette.bg }};text-align:center">
  <div class="wrap" style="max-width:680px">
    <h2 style="font-family:{{ tokens.type.display_family }};font-size:clamp(40px,5.6vw,80px);font-weight:{{ tokens.type.display_weight }};line-height:1;margin:0 0 24px;letter-spacing:-0.022em">{{ copy.cta_h|safe }}</h2>
    <p style="font-size:18px;color:rgba(255,255,255,.7);margin:0 0 36px">{{ copy.cta_sub }}</p>
    <a href="tel:{{ business.phone }}" style="background:{{ tokens.palette.accent }};color:#fff;padding:22px 44px;border-radius:999px;text-decoration:none;font-weight:600;font-size:17px">{{ business.phone_display }}</a>
  </div>
</section>
{% endblock %}
