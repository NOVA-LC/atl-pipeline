{# Roofer shell #3: veteran-heritage. Navy + cream + muted red, slab serif
   or stencil display, badge graphics, founder-in-uniform photo,
   "Veteran-Owned / Family-Owned Since 19XX" stamp. #}
{% extends "shells/_base.html.j2" %}

{% block main_content %}
<section class="hero" style="padding:80px 0;background:{{ tokens.palette.bg }};color:{{ tokens.palette.ink }};border-bottom:1px solid {{ tokens.palette.border }};position:relative">
  <div class="wrap">
    <div style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:60px;align-items:center" class="hero-grid">
      <div>
        <div style="display:inline-block;border:2px solid {{ tokens.palette.accent }};color:{{ tokens.palette.accent }};padding:6px 14px;font-family:{{ tokens.type.display_family }};font-size:11px;font-weight:700;letter-spacing:.4em;text-transform:uppercase;margin-bottom:36px">★ VETERAN-OWNED · FAMILY-OWNED{% if business.years %} · SINCE {{ year - business.years }}{% endif %} ★</div>
        <h1 data-motion="split-line-reveal" style="font-family:{{ tokens.type.display_family }};font-size:clamp(44px,7vw,108px);font-weight:{{ tokens.type.display_weight }};line-height:.96;letter-spacing:-0.018em;text-transform:uppercase;margin:0 0 32px">
          {{ copy.headline_top }}{% if copy.headline_em %}<br><span style="color:{{ tokens.palette.accent }};font-style:italic">{{ copy.headline_em }}</span>{% endif %}
        </h1>
        <p style="font-size:18px;line-height:1.55;color:{{ tokens.palette.muted }};max-width:540px;margin:0 0 36px">{{ copy.hero_sub }}</p>
        <div style="display:flex;gap:14px;flex-wrap:wrap">
          <a href="tel:{{ business.phone }}" style="background:{{ tokens.palette.accent }};color:#fff;padding:18px 32px;text-decoration:none;font-weight:700;font-size:15px;letter-spacing:.08em;text-transform:uppercase">Call · {{ business.phone_display }}</a>
          <a href="#services" style="border:1px solid {{ tokens.palette.ink }};color:{{ tokens.palette.ink }};padding:18px 32px;text-decoration:none;font-weight:700;font-size:15px;letter-spacing:.08em;text-transform:uppercase">What we do</a>
        </div>
      </div>
      {% if images.hero %}
      <figure style="margin:0;aspect-ratio:1/1.1;overflow:hidden;position:relative;border:8px solid {{ tokens.palette.ink }}">
        <img src="{{ images.hero }}" alt="{{ business.name }} owner-veteran" style="width:100%;height:100%;object-fit:cover;display:block;filter:contrast(1.05) saturate(.92)">
      </figure>
      {% endif %}
    </div>
  </div>
</section>
{% raw %}<style>@media(max-width:900px){.hero-grid{grid-template-columns:1fr !important;gap:36px !important}}</style>{% endraw %}

<section id="services" style="padding:120px 0;background:{{ tokens.palette.ink }};color:#fff">
  <div class="wrap">
    <div style="display:inline-block;border:1px solid {{ tokens.palette.accent }};color:{{ tokens.palette.accent }};padding:6px 12px;font-family:{{ tokens.type.display_family }};font-size:11px;font-weight:700;letter-spacing:.32em;text-transform:uppercase;margin-bottom:24px">WHAT WE DO</div>
    <h2 style="font-family:{{ tokens.type.display_family }};font-size:clamp(36px,5.4vw,72px);font-weight:{{ tokens.type.display_weight }};line-height:1;text-transform:uppercase;letter-spacing:-0.015em;margin:0 0 56px;max-width:880px">{{ copy.services_h|safe }}</h2>
    <div data-motion="reveal-up" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.12)">
      {% for svc in copy.services %}
      <div style="background:{{ tokens.palette.ink }};padding:36px 28px;display:flex;flex-direction:column;justify-content:space-between;min-height:200px">
        <div>
          <div style="font-family:{{ tokens.type.display_family }};font-size:14px;font-weight:700;color:{{ tokens.palette.accent }};margin-bottom:14px;letter-spacing:.12em;text-transform:uppercase">№ {{ '%02d'|format(loop.index) }}</div>
          <h3 style="font-family:{{ tokens.type.display_family }};font-size:22px;font-weight:{{ tokens.type.display_weight }};margin:0 0 10px;text-transform:uppercase;letter-spacing:-0.008em">{{ svc.title }}</h3>
          <p style="font-size:14px;line-height:1.65;color:rgba(255,255,255,.7);margin:0">{{ svc.body }}</p>
        </div>
        {% if svc.price_signal %}<div style="margin-top:18px;padding-top:14px;border-top:1px solid rgba(255,255,255,.15);font-weight:700;color:#fff;font-size:14px;letter-spacing:.04em">{{ svc.price_signal }}</div>{% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>

{% if copy.reviews_list %}
<section id="reviews" style="padding:120px 0;background:{{ tokens.palette.card_bg }}">
  <div class="wrap">
    <div style="display:inline-block;border:1px solid {{ tokens.palette.accent }};color:{{ tokens.palette.accent }};padding:6px 12px;font-family:{{ tokens.type.display_family }};font-size:11px;font-weight:700;letter-spacing:.32em;text-transform:uppercase;margin-bottom:24px">{{ business.rating }}★ × {{ business.reviews }} GOOGLE REVIEWS</div>
    <div data-motion="reveal-up" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:24px">
      {% for r in copy.reviews_list[:3] %}
      <div style="border:2px solid {{ tokens.palette.ink }};padding:28px;background:{{ tokens.palette.bg }}">
        <div style="color:{{ tokens.palette.accent }};font-size:14px;letter-spacing:3px;margin-bottom:14px">{{ '★' * (r.stars|default(5)) }}</div>
        <p style="font-size:15px;line-height:1.65;margin:0 0 16px;color:{{ tokens.palette.ink }}">&ldquo;{{ r.text }}&rdquo;</p>
        <div style="font-family:{{ tokens.type.display_family }};font-size:11px;color:{{ tokens.palette.muted }};letter-spacing:.18em;text-transform:uppercase;font-weight:700">— {{ r.author }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section id="contact" style="padding:120px 0;background:{{ tokens.palette.accent }};color:#fff;text-align:center">
  <div class="wrap" style="max-width:760px">
    <div style="display:inline-block;border:2px solid #fff;padding:6px 14px;font-family:{{ tokens.type.display_family }};font-size:11px;font-weight:700;letter-spacing:.4em;text-transform:uppercase;margin-bottom:36px">★ {{ business.city|upper }} ★</div>
    <h2 style="font-family:{{ tokens.type.display_family }};font-size:clamp(44px,6vw,88px);font-weight:{{ tokens.type.display_weight }};line-height:.96;letter-spacing:-0.02em;text-transform:uppercase;margin:0 0 32px">{{ copy.cta_h|safe }}</h2>
    <a href="tel:{{ business.phone }}" style="background:{{ tokens.palette.ink }};color:#fff;padding:22px 44px;text-decoration:none;font-weight:700;font-size:18px;letter-spacing:.08em;text-transform:uppercase">{{ business.phone_display }}</a>
  </div>
</section>
{% endblock %}
