{# Electrician shell #2: safety-industrial. White + safety-yellow + black,
   Inter Bold, hard-hat photo, bolt iconography, license # badge row.
   Reads journeyman-trades. #}
{% extends "shells/_base.html.j2" %}

{% block main_content %}
<section class="hero" style="padding:64px 0;background:#FFFFFF;color:#1A1A1A;border-bottom:6px solid #FFC72C">
  <div class="wrap">
    <div style="display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:60px;align-items:center" class="hero-grid">
      <div>
        <div style="display:inline-flex;align-items:center;gap:8px;background:#FFC72C;color:#1A1A1A;padding:6px 14px;font-size:11px;font-weight:800;letter-spacing:.24em;text-transform:uppercase;margin-bottom:32px">⚡ MASTER ELECTRICIAN · LICENSED · BONDED · INSURED</div>
        <h1 data-motion="split-line-reveal" style="font-family:{{ tokens.type.display_family }};font-size:clamp(48px,7vw,108px);font-weight:800;line-height:.96;letter-spacing:-0.022em;margin:0 0 32px;text-transform:uppercase">
          {{ copy.headline_top }}{% if copy.headline_em %}<br><span style="color:#1A1A1A;border-bottom:8px solid #FFC72C;padding-bottom:4px">{{ copy.headline_em }}</span>{% endif %}
        </h1>
        <p style="font-size:18px;line-height:1.55;color:#444;max-width:540px;margin:0 0 36px">{{ copy.hero_sub }}</p>
        <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:center">
          <a href="tel:{{ business.phone }}" style="background:#1A1A1A;color:#FFC72C;padding:20px 32px;text-decoration:none;font-weight:800;font-size:16px;letter-spacing:.04em;text-transform:uppercase">📞 {{ business.phone_display }}</a>
          <a href="#services" style="background:#FFC72C;color:#1A1A1A;padding:20px 32px;text-decoration:none;font-weight:800;font-size:16px;letter-spacing:.04em;text-transform:uppercase">SERVICES</a>
        </div>
      </div>
      {% if images.hero %}<figure style="margin:0;aspect-ratio:1/1;overflow:hidden;border:6px solid #FFC72C"><img src="{{ images.hero }}" alt="{{ business.name }} crew" style="width:100%;height:100%;object-fit:cover;display:block"></figure>{% endif %}
    </div>
  </div>
</section>
{% raw %}<style>@media(max-width:900px){.hero-grid{grid-template-columns:1fr !important;gap:36px !important}}</style>{% endraw %}

<section id="services" style="padding:100px 0;background:#1A1A1A;color:#FFFFFF">
  <div class="wrap">
    <div style="display:inline-block;background:#FFC72C;color:#1A1A1A;padding:6px 12px;font-size:11px;font-weight:800;letter-spacing:.24em;text-transform:uppercase;margin-bottom:20px">SERVICES</div>
    <h2 style="font-family:{{ tokens.type.display_family }};font-size:clamp(36px,5vw,68px);font-weight:800;line-height:1;letter-spacing:-0.02em;text-transform:uppercase;margin:0 0 48px;max-width:920px">{{ copy.services_h|safe }}</h2>
    <div data-motion="reveal-up" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px">
      {% for svc in copy.services %}
      <div style="padding:32px;background:#262626;border-top:4px solid #FFC72C;display:flex;flex-direction:column;justify-content:space-between;min-height:200px">
        <div>
          <div style="font-family:{{ tokens.type.display_family }};font-size:11px;font-weight:800;color:#FFC72C;margin-bottom:14px;letter-spacing:.2em;text-transform:uppercase">№ {{ '%02d'|format(loop.index) }}</div>
          <h3 style="font-family:{{ tokens.type.display_family }};font-size:22px;font-weight:800;margin:0 0 10px;line-height:1.15;text-transform:uppercase;letter-spacing:-0.01em">{{ svc.title }}</h3>
          <p style="font-size:14px;line-height:1.65;color:rgba(255,255,255,.7);margin:0">{{ svc.body }}</p>
        </div>
        {% if svc.price_signal %}<div style="margin-top:18px;padding-top:14px;border-top:1px dashed rgba(255,255,255,.18);font-weight:800;color:#FFC72C;font-size:14px;letter-spacing:.06em;text-transform:uppercase">{{ svc.price_signal }}</div>{% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>

{% if copy.reviews_list %}
<section id="reviews" style="padding:100px 0;background:#FFFFFF">
  <div class="wrap">
    <div style="display:inline-block;background:#1A1A1A;color:#FFC72C;padding:6px 12px;font-size:11px;font-weight:800;letter-spacing:.24em;text-transform:uppercase;margin-bottom:20px">{{ business.rating }}★ × {{ business.reviews }} REVIEWS</div>
    <div data-motion="reveal-up" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:24px;margin-top:24px">
      {% for r in copy.reviews_list[:3] %}
      <div style="border:2px solid #1A1A1A;padding:32px;background:#FFFFFF">
        <div style="color:#FFC72C;font-size:14px;letter-spacing:3px;margin-bottom:14px">{{ '★' * (r.stars|default(5)) }}</div>
        <p style="font-size:15px;line-height:1.65;margin:0 0 16px;color:#1A1A1A">&ldquo;{{ r.text }}&rdquo;</p>
        <div style="font-size:11px;color:#666;letter-spacing:.18em;text-transform:uppercase;font-weight:800">— {{ r.author }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section id="contact" style="padding:100px 0;background:#FFC72C;color:#1A1A1A;text-align:center">
  <div class="wrap" style="max-width:760px">
    <h2 style="font-family:{{ tokens.type.display_family }};font-size:clamp(40px,6vw,88px);font-weight:800;line-height:.96;letter-spacing:-0.02em;text-transform:uppercase;margin:0 0 24px">{{ copy.cta_h|safe }}</h2>
    <a href="tel:{{ business.phone }}" style="background:#1A1A1A;color:#FFC72C;padding:24px 48px;text-decoration:none;font-weight:800;font-size:20px;letter-spacing:.04em;text-transform:uppercase;display:inline-block">📞 {{ business.phone_display }}</a>
  </div>
</section>
{% endblock %}
