{# Auto shell #2: clinical-modern. White + steel blue + light gray, DM Sans,
   clean shop-floor photography, online-booking widget, drop-off+shuttle
   service strip. Reads dealership-quality independent. #}
{% extends "shells/_base.html.j2" %}

{% block main_content %}
<section class="hero" style="padding:80px 0;background:#FFFFFF;color:#1B4965;border-bottom:1px solid #E2E8EE">
  <div class="wrap">
    <div style="display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:64px;align-items:center" class="hero-grid">
      <div>
        <div style="display:inline-block;background:#E6F0F8;color:#1B4965;padding:6px 14px;border-radius:4px;font-size:12px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;margin-bottom:32px">ASE Certified · NAPA AutoCare · {{ business.city }}, GA</div>
        <h1 data-motion="split-line-reveal" style="font-family:{{ tokens.type.display_family }};font-size:clamp(44px,6.4vw,96px);font-weight:600;line-height:1.02;letter-spacing:-0.022em;margin:0 0 32px;color:#0F2E47">
          {{ copy.headline_top }}{% if copy.headline_em %} <span style="color:#62B6CB">{{ copy.headline_em }}</span>{% endif %}
        </h1>
        <p style="font-size:18px;line-height:1.55;color:#566D80;max-width:540px;margin:0 0 36px">{{ copy.hero_sub }}</p>
        <div style="display:flex;gap:14px;flex-wrap:wrap">
          <a href="tel:{{ business.phone }}" style="background:#1B4965;color:#fff;padding:18px 32px;border-radius:6px;text-decoration:none;font-weight:600;font-size:16px">📞 Book online · {{ business.phone_display }}</a>
          <a href="#services" style="border:1.5px solid #1B4965;color:#1B4965;padding:18px 32px;border-radius:6px;text-decoration:none;font-weight:600;font-size:16px">Services →</a>
        </div>
      </div>
      {% if images.hero %}<figure style="margin:0;aspect-ratio:4/5;overflow:hidden;border-radius:18px"><img src="{{ images.hero }}" alt="{{ business.name }} shop floor" style="width:100%;height:100%;object-fit:cover;display:block"></figure>{% endif %}
    </div>
  </div>
</section>
{% raw %}<style>@media(max-width:900px){.hero-grid{grid-template-columns:1fr !important;gap:36px !important}}</style>{% endraw %}

<section style="padding:36px 0;background:#62B6CB;color:#0F2E47">
  <div class="wrap" style="display:flex;gap:32px;flex-wrap:wrap;justify-content:center;align-items:center">
    {% for amenity in ['🚗 Loaner cars available', '🔑 After-hours key drop', '🚕 Free shuttle within 10mi', '💳 0% APR financing', '⏱ Most repairs same-day'] %}
    <span style="font-size:14px;font-weight:600;letter-spacing:.04em">{{ amenity }}</span>
    {% endfor %}
  </div>
</section>

<section id="services" style="padding:120px 0;background:#F6FAFC">
  <div class="wrap">
    <div style="font-family:{{ tokens.type.display_family }};font-size:13px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:#1B4965;margin-bottom:20px">Services</div>
    <h2 style="font-family:{{ tokens.type.display_family }};font-size:clamp(36px,5vw,68px);font-weight:600;line-height:1.05;letter-spacing:-0.018em;margin:0 0 48px;color:#0F2E47;max-width:880px">{{ copy.services_h|safe }}</h2>
    <div data-motion="reveal-up" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px">
      {% for svc in copy.services %}
      <div style="padding:32px 28px;background:#FFFFFF;border-radius:14px;display:flex;flex-direction:column;justify-content:space-between;min-height:200px;border:1px solid #E2E8EE">
        <div>
          <div style="width:40px;height:40px;border-radius:10px;background:#E6F0F8;color:#1B4965;display:flex;align-items:center;justify-content:center;font-weight:700;margin-bottom:18px">{{ loop.index }}</div>
          <h3 style="font-family:{{ tokens.type.display_family }};font-size:20px;font-weight:600;margin:0 0 10px;color:#0F2E47">{{ svc.title }}</h3>
          <p style="font-size:14px;line-height:1.65;color:#566D80;margin:0">{{ svc.body }}</p>
        </div>
        {% if svc.price_signal %}<div style="margin-top:18px;padding-top:14px;border-top:1px dashed #E2E8EE;font-weight:600;color:#1B4965;font-size:14px">{{ svc.price_signal }}</div>{% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>

{% if copy.reviews_list %}
<section id="reviews" style="padding:120px 0;background:#FFFFFF">
  <div class="wrap">
    <div style="font-family:{{ tokens.type.display_family }};font-size:13px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:#1B4965;margin-bottom:24px">{{ business.rating }}★ × {{ business.reviews }} on Google</div>
    <div data-motion="reveal-up" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:24px">
      {% for r in copy.reviews_list[:3] %}
      <div style="padding:32px;background:#F6FAFC;border-radius:14px;border-left:3px solid #62B6CB">
        <div style="color:#62B6CB;font-size:14px;letter-spacing:3px;margin-bottom:14px">{{ '★' * (r.stars|default(5)) }}</div>
        <p style="font-size:15px;line-height:1.65;margin:0 0 14px;color:#0F2E47">&ldquo;{{ r.text }}&rdquo;</p>
        <div style="font-size:12px;color:#566D80;letter-spacing:.08em;text-transform:uppercase;font-weight:600">— {{ r.author }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section id="contact" style="padding:100px 0;background:#0F2E47;color:#fff;text-align:center">
  <div class="wrap" style="max-width:720px">
    <h2 style="font-family:{{ tokens.type.display_family }};font-size:clamp(40px,5.4vw,76px);font-weight:600;line-height:1;letter-spacing:-0.022em;margin:0 0 24px">{{ copy.cta_h|safe }}</h2>
    <p style="font-size:18px;color:rgba(255,255,255,.7);margin:0 0 32px">{{ copy.cta_sub }}</p>
    <a href="tel:{{ business.phone }}" style="background:#62B6CB;color:#0F2E47;padding:22px 44px;border-radius:6px;text-decoration:none;font-weight:600;font-size:17px">{{ business.phone_display }}</a>
  </div>
</section>
{% endblock %}
