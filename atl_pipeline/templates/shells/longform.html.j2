{# Longform shell — narrative-heavy layout for storytelling-fit businesses.
   Same Tier 1 CRO + UI/UX polish baked in as standard.html.j2, but with more
   editorial chrome (serif logo, italic h5s, generous footer spacing).
#}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ business.name }}{% if copy.title_tagline %} — {{ copy.title_tagline }}{% endif %}</title>
<meta name="viewport" content="width=device-width,initial-scale=1">
{% if copy.meta_description %}<meta name="description" content="{{ copy.meta_description }}">{% endif %}
<meta name="theme-color" content="{{ tokens.palette.bg }}" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="{{ tokens.palette.ink }}" media="(prefers-color-scheme: dark)">
<meta name="view-transition" content="same-origin">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='{{ tokens.palette.accent|urlencode }}'/%3E%3Ctext x='32' y='44' text-anchor='middle' font-family='{{ tokens.type.display_family|replace("'", "") }}' font-size='38' font-weight='700' fill='{{ tokens.palette.bg|urlencode }}'%3E{{ business.name[0]|upper }}%3C/text%3E%3C/svg%3E">
<link rel="apple-touch-icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='{{ tokens.palette.accent|urlencode }}'/%3E%3Ctext x='32' y='44' text-anchor='middle' font-family='sans-serif' font-size='38' font-weight='700' fill='%23fff'%3E{{ business.name[0]|upper }}%3C/text%3E%3C/svg%3E">
<link href="{{ tokens.type.google_font_link }}" rel="preload" as="style">
<link href="{{ tokens.type.google_font_link }}" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:{{ tokens.type.body_family }};background:{{ tokens.palette.bg }};color:{{ tokens.palette.ink }};line-height:1.7;-webkit-font-smoothing:antialiased;font-weight:{{ tokens.type.body_weight }}}
.wrap{max-width:{{ tokens.spacing.wrap_max }};margin:0 auto;padding:0 {{ tokens.spacing.wrap_x }}}
.wrap-narrow{max-width:780px;margin:0 auto;padding:0 {{ tokens.spacing.wrap_x }}}

/* Focus-visible palette-matched ring */
:focus{outline:none}
:focus-visible{outline:2px solid {{ tokens.palette.accent }};outline-offset:3px;border-radius:4px;transition:outline-offset .15s ease}

/* Skip-to-content + sr-only utility */
.skip-link{position:absolute;left:-9999px;top:0;background:{{ tokens.palette.ink }};color:#fff;padding:10px 18px;text-decoration:none;font-weight:600;font-size:14px;z-index:9999;border-radius:0 0 6px 0}
.skip-link:focus{left:0}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}

/* Nav (longform: editorial logo treatment) */
nav{position:sticky;top:0;z-index:50;backdrop-filter:blur(14px);background:{{ tokens.palette.bg_blur }};border-bottom:1px solid {{ tokens.palette.border }};padding:18px 0}
.nav-row{display:flex;align-items:center;justify-content:space-between;gap:16px}
.logo{font-family:{{ tokens.type.display_family }};font-weight:{{ tokens.type.display_weight }};font-size:24px;letter-spacing:-0.01em;color:{{ tokens.palette.ink }}}
.logo em{color:{{ tokens.palette.accent }};font-style:italic}
.nav-links{display:flex;gap:36px;font-size:14px;font-weight:500}
.nav-links a{color:{{ tokens.palette.ink }};text-decoration:none;opacity:.65;letter-spacing:.02em;position:relative}
.nav-links a::after{content:"";position:absolute;left:0;bottom:-4px;width:100%;height:1px;background:{{ tokens.palette.accent }};transform:scaleX(0);transform-origin:right;transition:transform .35s cubic-bezier(.65,.05,.36,1)}
.nav-links a:hover{opacity:1}
.nav-links a:hover::after{transform:scaleX(1);transform-origin:left}
.nav-cta{padding:11px 22px;background:transparent;color:{{ tokens.palette.ink }};border:1px solid {{ tokens.palette.border }};border-radius:999px;text-decoration:none;font-size:14px;font-weight:500;white-space:nowrap}

/* Trust strip — editorial italic, slightly more generous */
.trust-strip{background:{{ tokens.palette.card_bg }};border-bottom:1px solid {{ tokens.palette.border }};padding:14px 0;font-size:14px;font-weight:400;color:{{ tokens.palette.muted }}}
.trust-strip .wrap{display:flex;gap:28px;align-items:center;justify-content:center;flex-wrap:wrap}
.trust-strip .ts-item{display:inline-flex;align-items:center;gap:6px}
.trust-strip .ts-item strong{color:{{ tokens.palette.ink }};font-family:{{ tokens.type.display_family }};font-weight:{{ tokens.type.display_weight }}}
.trust-strip .ts-star{color:#FBBF24}
.trust-strip .ts-dot{opacity:.3}

/* Sticky mobile CTA bar */
.sticky-cta{position:fixed;bottom:0;left:0;right:0;z-index:99;display:none;background:{{ tokens.palette.bg }};border-top:1px solid {{ tokens.palette.border }};padding:10px 12px;gap:8px;box-shadow:0 -10px 30px -10px rgba(0,0,0,.15)}
.sticky-cta a{flex:1;padding:14px 18px;border-radius:999px;text-decoration:none;font-weight:700;font-size:15px;text-align:center;display:inline-flex;align-items:center;justify-content:center;gap:8px}
.sticky-cta .cta-call{background:{{ tokens.palette.accent }};color:#fff}
.sticky-cta .cta-text{background:{{ tokens.palette.ink }};color:#fff}

/* Footer (longform editorial style) */
footer{padding:100px 0 100px;border-top:1px solid {{ tokens.palette.border }};font-size:14px;color:{{ tokens.palette.muted }};background:{{ tokens.palette.bg }}}
.foot-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:80px;margin-bottom:50px}
.foot-grid h5{font-family:{{ tokens.type.display_family }};font-size:14px;font-style:italic;margin-bottom:18px;color:{{ tokens.palette.ink }}}
.foot-grid p, .foot-grid a{display:block;padding:5px 0;color:{{ tokens.palette.muted }};text-decoration:none;font-size:14px}

/* Demo tag */
.demo-tag{position:fixed;bottom:24px;right:24px;background:{{ tokens.palette.ink }};color:#fff;padding:14px 22px;border-radius:999px;font-size:13px;font-weight:400;letter-spacing:.02em;z-index:100}
.demo-tag::before{content:'DEMO  ·  ';opacity:.55}

@media(max-width:900px){
  .nav-links,.foot-grid{display:none}
  .sticky-cta{display:flex}
  .demo-tag{bottom:84px;right:12px;padding:8px 14px;font-size:11px}
  footer{padding-bottom:120px}
  .trust-strip .wrap{gap:14px;font-size:12px}
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration:.001ms !important; transition-duration:.001ms !important; scroll-behavior:auto !important; }
}

/* View Transitions */
@keyframes vt-fade { from{opacity:0;transform:translateY(6px)} to{opacity:1;transform:none} }
::view-transition-old(root),::view-transition-new(root){animation:vt-fade .25s ease both}

/* Print */
@media print {
  nav, .sticky-cta, .demo-tag, video { display:none !important; }
  a[href]::after { content:" (" attr(href) ")"; font-size:.8em; opacity:.7; }
  body { color:#000; background:#fff; font: 12pt Georgia, serif; }
  h2, h3 { page-break-after: avoid; }
  img { max-width:100% !important; page-break-inside:avoid; }
  @page { margin: 1.5cm; }
}
</style>
</head>
<body>

<a href="#main" class="skip-link">Skip to content</a>

<nav><div class="wrap nav-row">
<div class="logo">{{ business.name }}</div>
<div class="nav-links">
<a href="#services">Services</a>
<a href="#gallery">Work</a>
{% if copy.reviews_list %}<a href="#reviews">Words</a>{% endif %}
<a href="#contact">Contact</a>
</div>
<a href="tel:{{ business.phone }}" class="nav-cta" aria-label="Call {{ business.name }} at {{ business.phone_display }}">{{ business.phone_display }}</a>
</div></nav>

{% if business.rating or business.reviews or business.years or copy.license_number %}
<div class="trust-strip" role="region" aria-label="Trust signals">
  <div class="wrap">
    {% if business.rating %}<span class="ts-item"><span class="ts-star">★</span> <strong>{{ business.rating }}</strong> <em>on Google</em></span>{% endif %}
    {% if business.reviews %}{% if business.rating %}<span class="ts-dot">·</span>{% endif %}<span class="ts-item"><strong>{{ business.reviews }}</strong> <em>reviews</em></span>{% endif %}
    {% if business.years %}<span class="ts-dot">·</span><span class="ts-item"><strong>{{ business.years }} years</strong> <em>serving {{ business.city }}</em></span>{% endif %}
    {% if copy.license_number %}<span class="ts-dot">·</span><span class="ts-item"><em>Licensed · Insured · </em><strong>#{{ copy.license_number }}</strong></span>
    {% else %}<span class="ts-dot">·</span><span class="ts-item"><em>Licensed &amp; Insured</em></span>{% endif %}
  </div>
</div>
{% endif %}

<main id="main">
{% if sections.hero %}{% include sections.hero %}{% endif %}
{% if sections.services %}{% include sections.services %}{% endif %}
{% if copy.what_we_dont_do %}
<section style="padding:50px 0;border-top:1px solid {{ tokens.palette.border }};border-bottom:1px solid {{ tokens.palette.border }};color:{{ tokens.palette.ink }}">
  <div class="wrap-narrow">
    <div style="font-family:{{ tokens.type.display_family }};font-size:13px;font-style:italic;color:{{ tokens.palette.accent }};text-transform:uppercase;letter-spacing:.2em;margin-bottom:24px;font-weight:600">What we don't do</div>
    <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:14px">
      {% for item in copy.what_we_dont_do %}
      <li style="font-family:{{ tokens.type.display_family }};font-size:22px;font-style:italic;line-height:1.5;color:{{ tokens.palette.muted }}">— {{ item }}</li>
      {% endfor %}
    </ul>
  </div>
</section>
{% endif %}
{% if copy.guarantee %}
<section style="padding:90px 0;background:{{ tokens.palette.card_bg }};color:{{ tokens.palette.ink }};text-align:center">
  <div class="wrap-narrow">
    <div style="font-family:{{ tokens.type.display_family }};font-size:13px;font-style:italic;color:{{ tokens.palette.accent }};text-transform:uppercase;letter-spacing:.2em;margin-bottom:24px;font-weight:600">Our guarantee</div>
    <p style="font-family:{{ tokens.type.display_family }};font-size:clamp(28px,3.6vw,52px);font-weight:{{ tokens.type.display_weight }};line-height:1.2;font-style:italic">{{ copy.guarantee }}</p>
  </div>
</section>
{% endif %}
{% if sections.gallery %}{% include sections.gallery %}{% endif %}
{% if sections.reviews and copy.reviews_list %}{% include sections.reviews %}{% endif %}
{% if sections.cta %}{% include sections.cta %}{% endif %}
</main>

<div class="sticky-cta" role="region" aria-label="Quick contact">
  <a href="tel:{{ business.phone }}" class="cta-call" aria-label="Call {{ business.name }}">📞 Call now</a>
  <a href="sms:{{ business.phone }}?&body=Hi%20{{ copy.owner_first_name|default('there')|urlencode }}%2C%20saw%20your%20site" class="cta-text" aria-label="Text {{ business.name }}">💬 Text us</a>
</div>

<footer><div class="wrap">
<div class="foot-grid">
<div>
  <div class="logo">{{ business.name }}</div>
  <p style="margin-top:18px;max-width:340px;font-style:italic;font-family:{{ tokens.type.display_family }};color:{{ tokens.palette.muted }};font-size:16px;line-height:1.65">{{ copy.footer_blurb }}</p>
</div>
<div><h5>Find us</h5>{% if business.address %}<p>{{ business.address }}</p>{% endif %}<p>{{ business.city }}, {{ business.state }}</p>{% if business.hours %}<p>{{ business.hours }}</p>{% endif %}</div>
<div><h5>Get in touch</h5><a href="tel:{{ business.phone }}">{{ business.phone_display }}</a><a href="sms:{{ business.phone }}">Text us</a>{% if business.google_maps_url %}<a href="{{ business.google_maps_url }}" target="_blank" rel="noopener">Google Maps</a>{% endif %}</div>
</div>
{% if copy.neighborhoods %}
<div style="margin-bottom:28px;padding:20px 0;border-top:1px solid {{ tokens.palette.border }};border-bottom:1px solid {{ tokens.palette.border }};font-size:14px;color:{{ tokens.palette.muted }};font-style:italic;font-family:{{ tokens.type.display_family }}">
  <span style="color:{{ tokens.palette.ink }};font-style:normal;font-family:inherit;text-transform:uppercase;letter-spacing:.1em;font-size:11px;margin-right:18px;font-weight:600">Areas we serve</span>
  {{ copy.neighborhoods|join(' · ') }}
</div>
{% endif %}
<div style="padding-top:36px;border-top:1px solid {{ tokens.palette.border }};display:flex;justify-content:space-between;font-size:13px;letter-spacing:.02em;flex-wrap:wrap;gap:8px">
<div>© {{ year }} {{ business.name }}{% if copy.license_number %} · License #{{ copy.license_number }}{% endif %}</div>
<div style="display:flex;gap:14px;align-items:center;flex-wrap:wrap">{% if business.rating %}<span>{{ business.rating }}★ across {{ business.reviews }} reviews</span>{% endif %}{% if copy.last_updated_label %}<span style="opacity:.7">Last updated {{ copy.last_updated_label }}</span>{% endif %}</div>
</div>
</div></footer>

<div class="demo-tag">{{ business.name }}</div>

{# Tab-blur title swap #}
{% raw %}<script>
(function(){
  try {
    var orig = document.title;
    var industry = {% endraw %}'{{ industry|default("local") }}'{% raw %};
    var copy = {
      plumber: '👋 still need a plumber?',
      hvac: '👋 still need ac help?',
      radiator: '👋 still need a radiator shop?',
      landscape: '👋 still need a landscaper?',
      septic: '👋 still need septic help?',
    };
    var away = copy[industry] || '👋 come back!';
    document.addEventListener('visibilitychange', function(){
      document.title = document.hidden ? away : orig;
    });
  } catch (_) {}
})();
</script>{% endraw %}

{# Console signature #}
{% raw %}<script>
(function(){
  try {
    var s = 'color:#0a0a0a;background:#f4d03f;padding:6px 10px;font:600 12px/1.4 ui-monospace;border-radius:4px';
    var m = 'color:#666;font:12px/1.4 ui-monospace';
    console.log('%c ▲ nova ', s, '%c  built in atlanta · hand-tuned for {% endraw %}{{ business.name }}{% raw %}', m);
    console.log('%cseeing this? we build sites like this for trades. nova.build/work', m);
  } catch (_) {}
})();
</script>{% endraw %}

{# Engagement beacon #}
{% raw %}<script>
(function(){
  try {
    var slug = location.pathname.split('/').filter(Boolean)[0] || location.hostname.split('.')[0];
    var origin = location.origin;
    var fired = { view: false, engaged: false };
    function send(event, extra) {
      if (fired[event]) return;
      fired[event] = true;
      var url = origin + '/api/track?slug=' + encodeURIComponent(slug) + '&event=' + event + (extra || '');
      try {
        if (navigator.sendBeacon) { navigator.sendBeacon(url); }
        else { var img = new Image(); img.src = url; }
      } catch (_) {}
    }
    send('view');
    var start = Date.now();
    var maxScrollPct = 0;
    function onScroll() {
      var docH = document.documentElement.scrollHeight - window.innerHeight;
      if (docH <= 0) return;
      var pct = Math.min(100, Math.round((window.scrollY / docH) * 100));
      if (pct > maxScrollPct) maxScrollPct = pct;
      maybeFire();
    }
    function maybeFire() {
      if (fired.engaged) return;
      var dwell = Date.now() - start;
      if (dwell >= 30000 && maxScrollPct >= 50) {
        send('engaged', '&dwell_ms=' + dwell + '&scroll_pct=' + maxScrollPct);
      }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    setInterval(maybeFire, 5000);
    window.addEventListener('beforeunload', function(){
      if (!fired.engaged) {
        var dwell = Date.now() - start;
        if (dwell >= 20000 && maxScrollPct >= 30) {
          send('engaged', '&dwell_ms=' + dwell + '&scroll_pct=' + maxScrollPct);
        }
      }
    });
  } catch (_) {}
})();
</script>{% endraw %}

</body>
</html>
