{# HVAC shell #1: clean-trade. Trade blue + white + orange CTA, DM Sans/Inter,
   technician-at-doorstep photo, "Book a Tune-Up" CTA, financing chip. #}
{% extends "shells/_base.html.j2" %}

{% block main_content %}
<section class="hero" style="position:relative;padding:80px 0;background:{{ tokens.palette.bg }};color:{{ tokens.palette.ink }}">
  <div class="wrap">
    <div style="display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:64px;align-items:center" class="hero-grid">
      <div>
        <div style="display:inline-flex;gap:8px;flex-wrap:wrap;margin-bottom:28px">
          <span style="background:{{ tokens.palette.accent }};color:#0E2238;padding:6px 12px;font-size:11px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;border-radius:3px">0% APR · 18 MONTHS</span>
          <span style="background:rgba(0,0,0,.05);color:{{ tokens.palette.ink }};padding:6px 12px;font-size:11px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;border-radius:3px">SAME-DAY APPTS</span>
        </div>
        <h1 data-motion="split-line-reveal" style="font-family:{{ tokens.type.display_family }};font-size:clamp(40px,6vw,88px);font-weight:700;line-height:1.02;letter-spacing:-0.02em;margin:0 0 28px">
          {{ copy.headline_top }}{% if copy.headline_em %}<br><span style="color:{{ tokens.palette.accent }}">{{ copy.headline_em }}</span>{% endif %}
        </h1>
        <p style="font-size:19px;line-height:1.55;color:{{ tokens.palette.muted }};margin:0 0 36px;max-width:540px">{{ copy.hero_sub }}</p>
        <div style="display:flex;gap:14px;flex-wrap:wrap">
          <a href="tel:{{ business.phone }}" style="background:{{ tokens.palette.accent }};color:#0E2238;padding:18px 32px;border-radius:8px;text-decoration:none;font-weight:700;font-size:16px">📞 Book a Tune-Up</a>
          <a href="#services" style="border:1.5px solid {{ tokens.palette.border }};color:{{ tokens.palette.ink }};padding:18px 32px;border-radius:8px;text-decoration:none;font-weight:700;font-size:16px">Service plans →</a>
        </div>
      </div>
      {% if images.hero %}
      <figure style="margin:0;aspect-ratio:4/5;overflow:hidden;border-radius:16px;box-shadow:0 30px 60px -30px rgba(14,76,146,.25)">
        <img src="{{ images.hero }}" alt="{{ business.name }} technician" style="width:100%;height:100%;object-fit:cover;display:block">
      </figure>
      {% endif %}
    </div>
  </div>
</section>
{% raw %}<style>@media(max-width:900px){.hero-grid{grid-template-columns:1fr !important;gap:32px !important}}</style>{% endraw %}

<section id="services" style="padding:120px 0;background:{{ tokens.palette.card_bg }}">
  <div class="wrap">
    <div style="font-family:{{ tokens.type.display_family }};font-size:13px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:{{ tokens.palette.accent }};margin-bottom:20px">— Heating · Cooling · Indoor Air</div>
    <h2 style="font-family:{{ tokens.type.display_family }};font-size:clamp(36px,5vw,64px);font-weight:700;line-height:1.05;margin:0 0 48px;max-width:880px">{{ copy.services_h|safe }}</h2>
    <div data-motion="reveal-up" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px">
      {% for svc in copy.services %}
      <div style="background:{{ tokens.palette.bg }};padding:32px 28px;border-radius:16px;display:flex;flex-direction:column;justify-content:space-between;min-height:200px;box-shadow:0 2px 0 {{ tokens.palette.border }}">
        <div>
          <div style="width:44px;height:44px;border-radius:12px;background:{{ tokens.palette.accent }}1A;color:{{ tokens.palette.accent }};display:flex;align-items:center;justify-content:center;font-weight:700;margin-bottom:18px">{{ '0%d'|format(loop.index) }}</div>
          <h3 style="font-family:{{ tokens.type.display_family }};font-size:19px;font-weight:700;margin:0 0 10px">{{ svc.title }}</h3>
          <p style="font-size:14px;line-height:1.6;color:{{ tokens.palette.muted }};margin:0">{{ svc.body }}</p>
        </div>
        {% if svc.price_signal %}<div style="margin-top:18px;padding-top:14px;border-top:1px dashed {{ tokens.palette.border }};font-weight:700;color:{{ tokens.palette.accent }};font-size:14px">{{ svc.price_signal }}</div>{% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section style="padding:80px 0;background:{{ tokens.palette.accent }};color:#0E2238;text-align:center">
  <div class="wrap" style="max-width:860px">
    <div style="font-size:13px;font-weight:700;letter-spacing:.3em;text-transform:uppercase;margin-bottom:20px;opacity:.7">— Comfort Club Membership</div>
    <h3 style="font-family:{{ tokens.type.display_family }};font-size:clamp(28px,3.6vw,48px);font-weight:700;line-height:1.15;margin:0 0 16px">Twice-a-year tune-up. Priority dispatch. 15% off repairs.</h3>
    <p style="font-size:17px;line-height:1.6;margin:0 0 28px;opacity:.85">$19/mo or $189/yr · cancel anytime · joins on the spot at your first visit.</p>
    <a href="tel:{{ business.phone }}" style="background:#0E2238;color:{{ tokens.palette.accent }};padding:18px 36px;border-radius:8px;text-decoration:none;font-weight:700">Talk to us about joining →</a>
  </div>
</section>

{% if copy.reviews_list %}
<section id="reviews" style="padding:120px 0;background:{{ tokens.palette.bg }}">
  <div class="wrap">
    <div style="font-family:{{ tokens.type.display_family }};font-size:13px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:{{ tokens.palette.accent }};margin-bottom:24px">— {{ business.rating }}★ × {{ business.reviews }} Google reviews</div>
    <div data-motion="reveal-up" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:24px">
      {% for r in copy.reviews_list[:3] %}
      <div style="background:{{ tokens.palette.card_bg }};padding:32px;border-radius:16px">
        <div style="color:{{ tokens.palette.accent }};font-size:14px;letter-spacing:3px;margin-bottom:14px">{{ '★' * (r.stars|default(5)) }}</div>
        <p style="font-size:15px;line-height:1.65;margin:0 0 16px">&ldquo;{{ r.text }}&rdquo;</p>
        <div style="font-size:12px;color:{{ tokens.palette.muted }};letter-spacing:.08em;text-transform:uppercase;font-weight:600">— {{ r.author }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section id="contact" style="padding:100px 0;background:{{ tokens.palette.ink }};color:#fff;text-align:center">
  <div class="wrap" style="max-width:720px">
    <h2 style="font-family:{{ tokens.type.display_family }};font-size:clamp(36px,5vw,68px);font-weight:700;margin:0 0 24px">{{ copy.cta_h|safe }}</h2>
    <p style="font-size:18px;color:rgba(255,255,255,.75);max-width:540px;margin:0 auto 32px">{{ copy.cta_sub }}</p>
    <a href="tel:{{ business.phone }}" style="background:{{ tokens.palette.accent }};color:#0E2238;padding:22px 44px;border-radius:8px;text-decoration:none;font-weight:700;font-size:18px;display:inline-flex;align-items:center;gap:12px">📞 {{ business.phone_display }}</a>
  </div>
</section>
{% endblock %}
