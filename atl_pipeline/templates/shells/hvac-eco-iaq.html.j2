{# HVAC shell #3: eco-iaq. Sage/forest + cream + black, leaf/particle motif,
   heat-pump rebate language, sustainability positioning. #}
{% extends "shells/_base.html.j2" %}

{% block main_content %}
<section class="hero" style="padding:120px 0;background:{{ tokens.palette.bg }};color:{{ tokens.palette.ink }};position:relative;overflow:hidden">
  <div class="wrap" style="position:relative">
    <div style="max-width:980px">
      <div style="display:inline-flex;align-items:center;gap:10px;background:rgba(63,94,63,.08);padding:8px 16px;border-radius:999px;font-size:13px;font-weight:600;color:{{ tokens.palette.ink }};margin-bottom:36px">
        <span style="width:8px;height:8px;background:{{ tokens.palette.accent }};border-radius:50%"></span>
        Up to $8,000 in heat-pump rebates available in {{ business.state|default('GA') }}
      </div>
      <h1 data-motion="split-line-reveal" style="font-family:{{ tokens.type.display_family }};font-size:clamp(48px,8vw,120px);font-weight:{{ tokens.type.display_weight }};line-height:.94;letter-spacing:-0.028em;margin:0 0 36px">
        {{ copy.headline_top }}{% if copy.headline_em %} <em style="font-style:italic;color:{{ tokens.palette.accent }};font-weight:{{ tokens.type.display_weight }}">{{ copy.headline_em }}</em>{% endif %}
      </h1>
      <p style="font-size:clamp(18px,1.5vw,22px);line-height:1.5;color:{{ tokens.palette.muted }};max-width:620px;margin:0 0 36px">{{ copy.hero_sub }}</p>
      <div style="display:flex;gap:14px;flex-wrap:wrap">
        <a href="tel:{{ business.phone }}" style="background:{{ tokens.palette.ink }};color:{{ tokens.palette.bg }};padding:20px 36px;text-decoration:none;font-weight:600;font-size:16px">Schedule energy audit</a>
        <a href="#services" style="color:{{ tokens.palette.ink }};padding:20px 18px;text-decoration:none;font-weight:600;border-bottom:2px solid {{ tokens.palette.accent }};font-size:16px">Heat pumps & IAQ →</a>
      </div>
    </div>
  </div>
</section>

<section style="padding:80px 0;background:{{ tokens.palette.ink }};color:{{ tokens.palette.bg }}">
  <div class="wrap">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:48px">
      {% for stat in [('$8,000','Heat-pump rebate (IRA 25C)'),('40%','Lower power bills with heat pumps'),('14 SEER+','Min efficiency we install'),('MERV-13','IAQ filtration standard')] %}
      <div>
        <div style="font-family:{{ tokens.type.display_family }};font-size:clamp(36px,4.6vw,72px);font-weight:{{ tokens.type.display_weight }};color:{{ tokens.palette.accent }};line-height:.95;letter-spacing:-0.02em;margin-bottom:10px">{{ stat[0] }}</div>
        <div style="font-size:13px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:rgba(241,236,222,.7)">{{ stat[1] }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section id="services" style="padding:120px 0;background:{{ tokens.palette.bg }}">
  <div class="wrap">
    <div style="font-family:{{ tokens.type.display_family }};font-size:12px;font-weight:600;letter-spacing:.3em;text-transform:uppercase;color:{{ tokens.palette.accent }};margin-bottom:20px">What we install</div>
    <h2 style="font-family:{{ tokens.type.display_family }};font-size:clamp(36px,5vw,68px);font-weight:{{ tokens.type.display_weight }};line-height:1;letter-spacing:-0.02em;margin:0 0 56px;max-width:880px">{{ copy.services_h|safe }}</h2>
    <div data-motion="reveal-up" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:32px">
      {% for svc in copy.services %}
      <div style="padding:32px 28px;border-left:2px solid {{ tokens.palette.accent }};background:{{ tokens.palette.card_bg }}">
        <h3 style="font-family:{{ tokens.type.display_family }};font-size:24px;font-weight:{{ tokens.type.display_weight }};margin:0 0 12px;letter-spacing:-0.01em">{{ svc.title }}</h3>
        <p style="font-size:15px;color:{{ tokens.palette.muted }};line-height:1.65;margin:0 0 14px">{{ svc.body }}</p>
        {% if svc.price_signal %}<div style="font-size:14px;font-weight:600;color:{{ tokens.palette.ink }};font-style:italic">{{ svc.price_signal }}</div>{% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>

{% if copy.reviews_list %}
<section id="reviews" style="padding:120px 0;background:{{ tokens.palette.card_bg }}">
  <div class="wrap">
    <div style="font-family:{{ tokens.type.display_family }};font-size:12px;font-weight:600;letter-spacing:.3em;text-transform:uppercase;color:{{ tokens.palette.accent }};margin-bottom:24px">{{ business.rating }}★ — homeowners switching to heat pumps</div>
    <div data-motion="reveal-up" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:40px">
      {% for r in copy.reviews_list[:3] %}
      <div>
        <p style="font-family:{{ tokens.type.display_family }};font-size:clamp(17px,1.6vw,22px);line-height:1.4;font-style:italic;margin:0 0 14px;color:{{ tokens.palette.ink }}">&ldquo;{{ r.text }}&rdquo;</p>
        <div style="font-size:12px;color:{{ tokens.palette.muted }};letter-spacing:.14em;text-transform:uppercase;font-weight:600">— {{ r.author }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section id="contact" style="padding:120px 0;background:{{ tokens.palette.ink }};color:{{ tokens.palette.bg }};text-align:center">
  <div class="wrap" style="max-width:720px">
    <h2 style="font-family:{{ tokens.type.display_family }};font-size:clamp(40px,5.4vw,80px);font-weight:{{ tokens.type.display_weight }};line-height:1;letter-spacing:-0.022em;margin:0 0 24px">{{ copy.cta_h|safe }}</h2>
    <p style="font-size:17px;color:rgba(241,236,222,.7);margin:0 0 32px">{{ copy.cta_sub }}</p>
    <a href="tel:{{ business.phone }}" style="background:{{ tokens.palette.accent }};color:{{ tokens.palette.bg }};padding:22px 44px;text-decoration:none;font-weight:600;font-size:17px">{{ business.phone_display }}</a>
  </div>
</section>
{% endblock %}
