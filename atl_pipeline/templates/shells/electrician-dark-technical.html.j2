{# Electrician shell #1: dark-technical. Near-black + amber/teal accent,
   Space Grotesk display, grid/circuit motif, EV charger + panel-upgrade
   photography. Reads modern-licensed-pro. #}
{% extends "shells/_base.html.j2" %}

{% block shell_css %}{{ super() }}
<style>
.circuit-bg{background-image:repeating-linear-gradient(0deg,rgba(255,180,0,.04) 0,rgba(255,180,0,.04) 1px,transparent 1px,transparent 48px),repeating-linear-gradient(90deg,rgba(255,180,0,.04) 0,rgba(255,180,0,.04) 1px,transparent 1px,transparent 48px)}
</style>
{% endblock %}

{% block main_content %}
<section class="hero circuit-bg" style="padding:100px 0 120px;background-color:#0B0F14;color:#F2F4F7;position:relative;overflow:hidden">
  <div class="wrap">
    <div style="display:inline-flex;align-items:center;gap:10px;font-family:'JetBrains Mono','SF Mono',monospace;font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:{{ tokens.palette.accent }};margin-bottom:36px">
      <span style="display:inline-block;width:6px;height:6px;background:{{ tokens.palette.accent }};border-radius:50%;box-shadow:0 0 12px {{ tokens.palette.accent }}"></span>
      LIVE · {{ business.city|upper }} · LICENSED
    </div>
    <h1 data-motion="split-line-reveal" style="font-family:{{ tokens.type.display_family }};font-size:clamp(52px,9vw,144px);font-weight:{{ tokens.type.display_weight }};line-height:.92;letter-spacing:-0.025em;margin:0 0 36px;max-width:1180px">
      {{ copy.headline_top }}{% if copy.headline_em %}<br><span style="color:{{ tokens.palette.accent }}">{{ copy.headline_em }}</span>{% endif %}
    </h1>
    <p style="font-size:clamp(17px,1.4vw,21px);line-height:1.55;color:rgba(242,244,247,.78);max-width:620px;margin:0 0 40px">{{ copy.hero_sub }}</p>
    <div style="display:flex;gap:14px;flex-wrap:wrap">
      <a href="tel:{{ business.phone }}" style="background:{{ tokens.palette.accent }};color:#0B0F14;padding:20px 36px;text-decoration:none;font-weight:700;font-size:16px;letter-spacing:.04em;display:inline-flex;align-items:center;gap:10px">⚡ Call · {{ business.phone_display }}</a>
      <a href="#services" style="border:1px solid rgba(255,255,255,.2);color:#F2F4F7;padding:20px 36px;text-decoration:none;font-weight:600;font-size:16px">Services →</a>
    </div>
  </div>
</section>

<section style="background:#141A22;padding:48px 0;border-top:1px solid rgba(255,255,255,.08);border-bottom:1px solid rgba(255,255,255,.08);color:#F2F4F7">
  <div class="wrap">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:24px 32px;align-items:center">
      {% for badge in [('Master Electrician','GA Lic'),('EV Charger','Tesla / ChargePoint / Wallbox'),('Panel Upgrades','200A / 400A / Smart'),('Storm Generator','Standby Ready')] %}
      <div>
        <div style="font-family:'JetBrains Mono','SF Mono',monospace;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:{{ tokens.palette.accent }};margin-bottom:6px">{{ badge[0] }}</div>
        <div style="font-size:14px;color:rgba(242,244,247,.7)">{{ badge[1] }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section id="services" style="padding:120px 0;background:#0B0F14;color:#F2F4F7">
  <div class="wrap">
    <div style="font-family:'JetBrains Mono','SF Mono',monospace;font-size:12px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:{{ tokens.palette.accent }};margin-bottom:20px">// SERVICES</div>
    <h2 style="font-family:{{ tokens.type.display_family }};font-size:clamp(40px,5.4vw,72px);font-weight:{{ tokens.type.display_weight }};line-height:1;margin:0 0 56px;letter-spacing:-0.022em;max-width:880px">{{ copy.services_h|safe }}</h2>
    <div data-motion="reveal-up" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1px;background:rgba(255,255,255,.08)">
      {% for svc in copy.services %}
      <div style="background:#0B0F14;padding:36px 28px;display:flex;flex-direction:column;justify-content:space-between;min-height:220px;border:1px solid rgba(255,255,255,.06)">
        <div>
          <div style="font-family:'JetBrains Mono','SF Mono',monospace;font-size:11px;font-weight:600;color:{{ tokens.palette.accent }};margin-bottom:14px;letter-spacing:.16em">{{ '0%d / 0%d'|format(loop.index, copy.services|length) }}</div>
          <h3 style="font-family:{{ tokens.type.display_family }};font-size:22px;font-weight:{{ tokens.type.display_weight }};margin:0 0 10px;letter-spacing:-0.012em">{{ svc.title }}</h3>
          <p style="font-size:14px;line-height:1.65;color:rgba(242,244,247,.7);margin:0">{{ svc.body }}</p>
        </div>
        {% if svc.price_signal %}<div style="margin-top:20px;font-family:'JetBrains Mono','SF Mono',monospace;font-size:13px;color:{{ tokens.palette.accent }};letter-spacing:.04em">→ {{ svc.price_signal }}</div>{% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>

{% if copy.reviews_list %}
<section id="reviews" style="padding:120px 0;background:#141A22;color:#F2F4F7">
  <div class="wrap">
    <div style="font-family:'JetBrains Mono','SF Mono',monospace;font-size:12px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:{{ tokens.palette.accent }};margin-bottom:24px">// {{ business.rating }}★ × {{ business.reviews }} REVIEWS</div>
    <div data-motion="reveal-up" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:24px">
      {% for r in copy.reviews_list[:3] %}
      <div style="background:#0B0F14;padding:32px;border:1px solid rgba(255,255,255,.08)">
        <div style="color:{{ tokens.palette.accent }};font-size:14px;letter-spacing:3px;margin-bottom:14px">{{ '★' * (r.stars|default(5)) }}</div>
        <p style="font-size:15px;line-height:1.6;margin:0 0 16px;color:rgba(242,244,247,.85)">&ldquo;{{ r.text }}&rdquo;</p>
        <div style="font-family:'JetBrains Mono','SF Mono',monospace;font-size:11px;color:rgba(242,244,247,.5);letter-spacing:.1em">— {{ r.author|upper }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section id="contact" style="padding:120px 0;background:#0B0F14;color:#F2F4F7;text-align:center">
  <div class="wrap" style="max-width:720px">
    <h2 style="font-family:{{ tokens.type.display_family }};font-size:clamp(40px,5.6vw,84px);font-weight:{{ tokens.type.display_weight }};line-height:1;letter-spacing:-0.024em;margin:0 0 24px">{{ copy.cta_h|safe }}</h2>
    <p style="color:rgba(242,244,247,.65);margin:0 0 36px;font-size:17px">{{ copy.cta_sub }}</p>
    <a href="tel:{{ business.phone }}" style="background:{{ tokens.palette.accent }};color:#0B0F14;padding:24px 48px;text-decoration:none;font-weight:700;font-size:18px;letter-spacing:.04em">⚡ {{ business.phone_display }}</a>
  </div>
</section>
{% endblock %}
