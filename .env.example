# GitHub
GITHUB_TOKEN=github_pat_xxx
GITHUB_OWNER=NOVA-LC

# Demos repo (where the 50 demos live and auto-deploy to Vercel)
DEMOS_REPO_NAME=atlanta-website-demos
DEMOS_REPO_LOCAL=./demos_repo
DEMOS_REPO_VERCEL_REPO_ID=1223992190

# Vercel
VERCEL_TOKEN=vcp_xxx
VERCEL_TEAM_ID=

# Resend
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=tyler@gonenova.com
RESEND_FROM_NAME=Tyler · Nova
RESEND_REPLY_TO=tyler@gonenova.com

# CAN-SPAM compliance — REQUIRED. Every commercial email must include a real
# physical mailing address in the footer. FTC fine is up to $51K per email
# without one. Use a real street address (a P.O. Box is fine).
NOVA_MAILING_ADDRESS=123 Your St, Atlanta, GA 30303

# Gmail App Password — for IMAP scan that auto-marks replies + unsubscribes.
# Generate at https://myaccount.google.com/apppasswords (requires 2FA enabled).
# Without this, you'll have to run mark-replied / mark-unsubscribed manually.
GMAIL_APP_PASSWORD=

# Twilio — Day-1 SMS sender. Required for phone-outreach mode.
# Sign up: https://console.twilio.com  → buy a number → register 10DLC Brand+Campaign
# 10DLC registration costs ~$4-50/mo and takes 1-3 days. Without it, sends >5/day
# will be filtered by carriers. Tyler has the license — still need provider registration.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+14045551234   # E.164 format

# Slybroadcast — Day-3 ringless voicemail drop (~$0.10/drop).
# Sign up at slybroadcast.com, record one generic message in Tyler's voice,
# upload as MP3 and put the public URL here.
SLYBROADCAST_USER=
SLYBROADCAST_PASS=
SLYBROADCAST_AUDIO_URL=https://example.com/tyler-vm.mp3
SLYBROADCAST_CALLER_ID=        # 10-digit number that appears on caller ID (often = TWILIO_FROM_NUMBER)

# Anthropic (for research + email writing)
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-haiku-4-5-20251001    # default: Haiku (cheap path: ~$8/mo at 50/day)
# ANTHROPIC_MODEL=claude-sonnet-4-6           # upgrade for deeper research (~$80/mo at 50/day)

# Brave Search — free 2k queries/mo, $5/mo for 20k. Cheaper than Anthropic web_search.
BRAVE_API_KEY=

# Outscraper (autonomous daily scraping)
OUTSCRAPER_API_KEY=

# Email enrichment — find owner emails for leads without one
HUNTER_API_KEY=
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=
REOON_API_KEY=    # optional — deeper email verification ($0.0007/check)

# Brave Search API — replaces paid LLM web_search for owner LinkedIn / website / review hunting
# Free 2,000 queries/mo, $5/mo for 20k. Sign up: https://api.search.brave.com/app/keys
BRAVE_API_KEY=

# gonenova blog drop
GONENOVA_REPO_NAME=gonenova
GONENOVA_BLOG_PATH=src/content/blog
